{
  "name": "feedma-nest-modules",
  "version": "0.0.1",
  "description": "This project contains modules for projects based on Nest Js",
  "author": "esalazarv.develop@gmail.com",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "lerna run build",
    "format": "lerna run format",
    "lint": "lerna run lint",
    "test": "lerna run test",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/e2e/jest-e2e.json",
    "prepare": "husky",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "prebuild": "rimraf lib",
    "version:stable": "lerna version --yes --conventional-commits --conventional-graduate --create-release github --loglevel=verbose",
    "publish:canary": "lerna publish --canary --preid canary --dist-tag canary --pre-dist-tag canary --allow-branch \"**\" --no-git-tag-version --no-push --yes --loglevel=verbose",
    "publish:next": "lerna publish --conventional-commits --conventional-prerelease --preid next --dist-tag next --pre-dist-tag next --allow-branch \"**\" --no-git-tag-version --no-push --yes --loglevel=verbose",
    "publish:stable": "lerna publish from-package --yes --loglevel=verbose",
    "publish:missing": "lerna publish from-package --yes --loglevel=verbose",
    "publish:dev": "lerna run build && lerna run publish:dev"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@nestjs/platform-express": "^11.2.1",
    "graphql-ws": "^6.0.6",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.1",
    "@types/semver": "7.8.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "lerna": "10.0.0",
    "lint-staged": "^17.3.0",
    "nestjs-cls": "^6.2.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "semver": "7.8.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "{src,apps,libs,test,packages}/**/*.ts": [
      "eslint --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "main": "test/app/main.js",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/feedma/feedma-nest-modules.git"
  },
  "keywords": [
    "nestjs",
    "modules",
    "lib",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/feedma/feedma-nest-modules/issues"
  },
  "homepage": "https://github.com/feedma/feedma-nest-modules#readme"
}
