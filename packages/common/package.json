{
  "name": "@feedma/nest-common",
  "version": "0.3.1",
  "description": "Common resources for nest services",
  "keywords": [
    "nest",
    "common"
  ],
  "author": "Eduardo Salazar <eduardo.develop@gmail.com>",
  "homepage": "https://github.com/feedma/feedma-nest-modules#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/feedma/feedma-nest-modules.git"
  },
  "scripts": {
    "prebuild": "rimraf lib",
    "build": "tsc --build",
    "test": "jest --passWithNoTests",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "publish:dev": "npx yalc publish"
  },
  "bugs": {
    "url": "https://github.com/feedma/feedma-nest-modules/issues"
  },
  "devDependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.4",
    "express": "5.1.0",
    "nest-winston": "1.10.2",
    "nestjs-cls": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "11.x",
    "@nestjs/config": "4.x",
    "@nestjs/core": "11.x",
    "@nestjs/graphql": "13.x",
    "express": "5.x",
    "nest-winston": "1.x",
    "nestjs-cls": "5.x || 6.x",
    "reflect-metadata": "^0.2.x",
    "rxjs": "7.x"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
