{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./lib",
    // Keep the incremental build cache out of `lib`: `files: ["lib"]`
    // publishes that directory wholesale, and TypeScript writes this file
    // into `outDir` by default. It is a build artefact with no runtime
    // purpose, and it dwarfs the code it accompanies.
    "tsBuildInfoFile": "./.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"],
  "references": [
    {
      "path": "../testing"
    }
  ]
}
